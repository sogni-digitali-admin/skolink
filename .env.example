APP_NAME=School-Plus
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_CONNECTION=reverb
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=admin@school.com
MAIL_FROM_NAME="${APP_NAME}"

REMINDER=mail

MAIL_STATUS=on

SMS_GATEWAY=MSG91
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=""
SMS_GATEWAY_ROUTE_NO=4

SMS_STATUS=off

REVERB_APP_ID=gegok12
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

MIX_REVERB_APP_KEY="${REVERB_APP_KEY}"
MIX_REVERB_HOST="${REVERB_HOST}"
MIX_REVERB_PORT="${REVERB_PORT}"
MIX_REVERB_SCHEME="${REVERB_SCHEME}"

# generate with: php artisan webpush:vapid
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

FILESYSTEM_DISK='uploads'

TIMEZONE = 'Indian/Mauritius'

DEBUGBAR_ENABLED = false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

SCOUT_QUEUE=true

ALGOLIA_APP_ID =
ALGOLIA_SECRET =

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_KEY=
TWILIO_SECRET=

CACHE_TIME=8400

SNOOZE_TIME=600

ADDON_API_URL=

GOOGLE_MAPS_API_KEY=
